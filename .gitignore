# ==============================================================================
# Git Ignore Configuration - Avatar Elements (Minecraft Java 1.21.1 / Fabric)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Gradle & Fabric Loom Build Outputs
# ------------------------------------------------------------------------------
.gradle/
build/
out/
bin/
mod/.gradle/
mod/build/
mod/out/
mod/bin/
mod/com/
.loom-cache/
mod/.loom-cache/
remapped_mods/
gradle-app.setting
.gradletasknamecache

# Java compilation artifacts
*.class

# Jar archives (ignore all jars except Gradle Wrapper)
*.jar
!**/gradle/wrapper/gradle-wrapper.jar
!**/gradle-wrapper.jar

# ------------------------------------------------------------------------------
# 2. Minecraft Runtime Environment & Dedicated Server Data
# ------------------------------------------------------------------------------
run/
mod/run/
logs/
mod/logs/
crash-reports/
mod/crash-reports/
*.log

# Sensitive/Stateful world & server files (never commit)
mod/run/saves/
mod/run/world/
mod/run/server.properties
mod/run/ops.json
mod/run/whitelist.json
mod/run/banned-*.json
mod/run/usercache.json*
mod/run/eula.txt
mod/run/mods/
mod/run/config/

# ------------------------------------------------------------------------------
# 3. IDE, Editor & Antigravity Metadata
# ------------------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/
.antigravity/
.settings/
.project
.classpath

# ------------------------------------------------------------------------------
# 4. Reference Binaries & Large Media Archives
# ------------------------------------------------------------------------------
# External reference files (JARs, Addons, ZIPs)
reference/*
!reference/.gitkeep
!reference/README.md

# Package exports in root & unneeded archives
*.zip
*.rar
*.7z
*.tar
*.tar.gz
*.mcaddon
*.mcpack
!legacy/*.zip

# ------------------------------------------------------------------------------
# 5. Legacy Root Duplicates
# ------------------------------------------------------------------------------
# Root-level legacy python generator scripts (tracked canonical versions live in legacy/)
/*.py

# ------------------------------------------------------------------------------
# 6. Python Environments & Caches
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
ENV/

# ------------------------------------------------------------------------------
# 7. Operating System & Temporary Files
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.bak
*~
.tmp*/
*.driveupload*/

# ------------------------------------------------------------------------------
# 8. Secrets & Local Environment Overrides
# ------------------------------------------------------------------------------
*.env
*.env.*
secrets.properties
local.properties
